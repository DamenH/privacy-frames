{
  "name": "privacy-frames-static-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:production": "npm run build",
    "test": "node --test test/policy.test.ts test/build.test.ts test/import.test.ts && node test/run.ts && node test/scoped-storage.ts && node test/separate-runtime.ts && node test/website-installation.ts",
    "test:storage-policy": "node test/storage-policy.ts",
    "test:mobile": "node test/mobile.ts",
    "test:compatibility": "node test/compatibility.ts",
    "test:pitch": "node test/pitch-training.ts",
    "test:network": "node test/network.ts && NETWORK_BROWSER=firefox node test/network.ts",
    "serve": "node test/serve.ts",
    "test:embedding": "node test/embedding.ts",
    "test:assets": "node test/assets.ts",
    "test:deployed": "node test/deployed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts test *.json .github deployment --ignore-unknown",
    "format:check": "prettier --check src scripts test *.json .github deployment --ignore-unknown",
    "build:examples": "tsx scripts/build-examples.ts",
    "test:wasm": "node test/wasm.ts",
    "test:review": "node test/evaluation-review.ts",
    "test:lifecycle": "node test/lifecycle.ts"
  },
  "dependencies": {
    "es-module-lexer": "^3.0.4",
    "parse5": "8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ses": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "marked": "^18.1.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
