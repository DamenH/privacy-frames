{
  "name": "privacy-frames-static-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node report.mjs",
    "build:production": "node deployment/build.mjs",
    "test": "node --test test/policy.test.mjs test/build.test.mjs test/import.test.mjs && node test/run.mjs && node test/scoped-storage.mjs && node test/separate-runtime.mjs && node test/website-installation.mjs",
    "test:upgrade": "node test/upgrade.mjs",
    "test:storage-policy": "node test/storage-policy.mjs",
    "test:mobile": "node test/mobile.mjs",
    "test:compatibility": "node test/compatibility.mjs",
    "test:pitch": "node test/pitch-training.mjs",
    "test:network": "node test/network.mjs && NETWORK_BROWSER=firefox node test/network.mjs",
    "serve": "node test/serve.mjs",
    "test:deployed": "node test/deployed.mjs"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "ses": "^2.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "marked": "^18.1.1",
    "playwright": "1.63.0"
  }
}
